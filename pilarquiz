<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Competitivo: CEM</title>
  
  <!-- Tailwind CSS para o design -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome para os ícones -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    /* Animação personalizada de ressalto para os pontos */
    @keyframes custom-bounce {
      0%, 100% { transform: translateY(-15%); animation-timing-function: cubic-bezier(0.8,0,1,1); }
      50% { transform: none; animation-timing-function: cubic-bezier(0,0,0.2,1); }
    }
    .animate-bounce-custom {
      animation: custom-bounce 1s infinite;
    }
  </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen text-slate-800 selection:bg-blue-200">
  
  <!-- Contentor Principal da Aplicação -->
  <div id="app"></div>

  <script>
    // --- IMAGEM LOGO ---
    // A sua imagem em Base64 inserida corretamente
    const logoUrl = "data:image/png;base64,";

    // --- DADOS INICIAIS ---
    const defaultQuestions = [
      { id: 1, text: 'Qual é a Crença central do Grupo Moura?', options: [{ text: 'Fortalecer vínculos garante um futuro melhor', isCorrect: true }, { text: 'Fazer o novo para perpetuar o negócio', isCorrect: false }, { text: 'Buscar o crescimento sustentável a qualquer custo', isCorrect: false }] },
      { id: 2, text: 'O que significa a sigla CEM?', options: [{ text: 'Cultura Empresarial Moura', isCorrect: true }, { text: 'Centro de Excelência Moura', isCorrect: false }, { text: 'Conduta e Ética Moura', isCorrect: false }] },
      { id: 3, text: 'Qual destes NÃO é um dos Valores do Grupo Moura descritos na cartilha?', options: [{ text: 'Competitividade', isCorrect: true }, { text: 'Integridade', isCorrect: false }, { text: 'Persistência', isCorrect: false }] },
      { id: 4, text: 'De acordo com o Princípio 2, qual é o lema sobre a simplicidade?', options: [{ text: 'Simplificar para superar', isCorrect: true }, { text: 'O complexo traz a excelência', isCorrect: false }, { text: 'Fazer mais com menos', isCorrect: false }] },
      { id: 5, text: 'O que é o "espírito de dono" no Grupo Moura (Princípio 6)?', options: [{ text: 'Assumir responsabilidades, arcar com consequências e cuidar do negócio', isCorrect: true }, { text: 'Ter ações na bolsa de valores da empresa', isCorrect: false }, { text: 'Trabalhar sozinho sem precisar da liderança', isCorrect: false }] },
      { id: 6, text: 'Qual método é considerado vital para atingir e manter resultados (Princípio 9)?', options: [{ text: 'O método PDCA', isCorrect: true }, { text: 'O método 5S', isCorrect: false }, { text: 'O sistema de recompensas', isCorrect: false }] },
      { id: 7, text: 'O que a cartilha diz sobre a "Liderança" (Princípio 8)?', options: [{ text: 'Atitudes são mais importantes que palavras, acreditando na liderança pelo exemplo', isCorrect: true }, { text: 'Os líderes devem centralizar todas as decisões importantes', isCorrect: false }, { text: 'Os líderes buscam pessoas que sejam sempre subordinadas a eles', isCorrect: false }] },
      { id: 8, text: 'No Grupo Moura, como as pessoas são recompensadas segundo o Princípio 5?', options: [{ text: 'Pela meritocracia e entrega de resultados', isCorrect: true }, { text: 'Apenas pelo tempo de casa (antiguidade)', isCorrect: false }, { text: 'Pelo grau de escolaridade e diplomas', isCorrect: false }] },
      { id: 9, text: 'Como a empresa encara os erros e acertos (Princípio 2)?', options: [{ text: 'Celebramos os acertos e aprendemos com os erros com humildade', isCorrect: true }, { text: 'Punimos os erros severamente para evitar repetições', isCorrect: false }, { text: 'Ignoramos os erros para manter o clima positivo', isCorrect: false }] },
      { id: 10, text: 'O que o Princípio 10 ("Fazemos mais com menos") prega sobre ostentação?', options: [{ text: 'Somos austeros, não gostamos de ostentação', isCorrect: true }, { text: 'A ostentação é necessária para mostrar poder de mercado', isCorrect: false }, { text: 'A austeridade deve ser evitada para não desmotivar a equipe', isCorrect: false }] },
      { id: 11, text: 'Em relação aos clientes, qual é o lema de trabalho do Grupo Moura (Princípio 14)?', options: [{ text: 'Trabalhamos com o foco no foco dos nossos clientes', isCorrect: true }, { text: 'O cliente tem sempre razão, mesmo quando vai contra os valores', isCorrect: false }, { text: 'O foco principal é apenas na venda imediata', isCorrect: false }] },
      { id: 12, text: 'O que o Grupo Moura busca de forma permanente em relação à qualidade (Princípio 11)?', options: [{ text: 'A busca do "zero defeito"', isCorrect: true }, { text: 'A qualidade aceitável dentro da margem da indústria', isCorrect: false }, { text: 'Qualidade variável dependendo do tipo de produto', isCorrect: false }] },
      { id: 13, text: 'Como é definido o trabalho em equipe (Princípio 7)?', options: [{ text: 'A cooperação potencializa os resultados em um ambiente informal', isCorrect: true }, { text: 'A cooperação atrasa as decisões, a individualidade é melhor', isCorrect: false }, { text: 'As decisões devem ser feitas em ambientes estritamente formais', isCorrect: false }] },
      { id: 14, text: 'Como a empresa lida com as decisões e visão de futuro (Princípios 10 e 13)?', options: [{ text: 'Não agimos com imediatismo, as decisões contemplam o olhar para o futuro', isCorrect: true }, { text: 'O lucro no trimestre atual é a única prioridade', isCorrect: false }, { text: 'Arriscamos todos os recursos para dominar o mercado', isCorrect: false }] },
      { id: 15, text: 'Qual é a Missão da divisão de Construção Civil do Grupo Moura?', options: [{ text: 'Realizar o sonho da casa própria construindo moradias acolhedoras e com qualidade', isCorrect: true }, { text: 'Construir prédios comerciais luxuosos', isCorrect: false }, { text: 'Fazer moradias temporárias para rápida expansão', isCorrect: false }] },
      { id: 16, text: 'A segurança e a integridade das pessoas são de responsabilidade de quem?', options: [{ text: 'De todos, e devem ser garantidas a qualquer custo', isCorrect: true }, { text: 'Apenas do setor de Segurança do Trabalho', isCorrect: false }, { text: 'Exclusivamente dos diretores', isCorrect: false }] },
      { id: 17, text: 'No que diz respeito ao aprendizado constante, o Grupo Moura afirma que "Aprendemos..."', options: [{ text: '...fazendo', isCorrect: true }, { text: '...apenas em salas de aula', isCorrect: false }, { text: '...somente com a teoria', isCorrect: false }] },
      { id: 18, text: 'O que é fundamental para a obtenção e manutenção dos resultados, segundo o Princípio 2?', options: [{ text: 'O Sistema Moura de Gestão (SMG)', isCorrect: true }, { text: 'O sistema de premiação por produtividade', isCorrect: false }, { text: 'A contratação de consultorias externas', isCorrect: false }] },
      { id: 19, text: 'Segundo o Princípio 3 ("Pensamos grande"), como o Grupo encara novos desafios?', options: [{ text: 'Como condição essencial para o crescimento da empresa', isCorrect: true }, { text: 'Com extremo cuidado, evitando qualquer mudança', isCorrect: false }, { text: 'Como um problema para as lideranças', isCorrect: false }] },
      { id: 20, text: 'O que a cartilha fala sobre "Mudanças internas de funções"?', options: [{ text: 'São bem-vindas e estimuladas, como oportunidade de desenvolvimento', isCorrect: true }, { text: 'Devem ser evitadas para não desestabilizar os times', isCorrect: false }, { text: 'Só ocorrem quando alguém é demitido', isCorrect: false }] },
    ];

    const TOTAL_ROUNDS = 5;

    // --- ESTADO GLOBAL ---
    let state = {
      view: 'menu', // menu, setup, intermission, play, podium, manage
      questions: [],
      playerCount: 1,
      players: [],
      currentRound: 1,
      currentPlayerIndex: 0,
      usedQuestionIds: [],
      currentQuestion: null,
      selectedOption: null,
      isAnswering: false,
      maxTimeMs: 15000,
      timeLeft: 15000,
      earnedPoints: null,
      timerInterval: null
    };

    // --- FUNÇÕES UTILITÁRIAS ---
    function shuffleArray(array) {
      let newArr = [...array];
      for (let i = newArr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [newArr[i], newArr[j]] = [newArr[j], newArr[i]];
      }
      return newArr;
    }

    function saveQuestions() {
      localStorage.setItem('ma_quiz_questions', JSON.stringify(state.questions));
    }

    function loadQuestions() {
      const saved = localStorage.getItem('ma_quiz_questions');
      if (saved) {
        try { state.questions = JSON.parse(saved); } catch (e) { state.questions = defaultQuestions; }
      } else {
        state.questions = defaultQuestions;
      }
    }

    // --- LÓGICA DO JOGO ---
    function changeView(newView) {
      state.view = newView;
      render();

      if (newView === 'play') {
        state.timeLeft = state.maxTimeMs;
        clearInterval(state.timerInterval);
        state.timerInterval = setInterval(() => {
          if (!state.isAnswering) {
            state.timeLeft = Math.max(0, state.timeLeft - 100);
            updateTimerUI();
            
            if (state.timeLeft === 0) {
              clearInterval(state.timerInterval);
              handleTimeOut();
            }
          }
        }, 100);
      } else {
        clearInterval(state.timerInterval);
      }
    }

    function updatePlayerCount(num) {
      state.playerCount = num;
      state.players = Array(num).fill().map(() => ({ name: '', score: 0 }));
      render();
    }

    function updatePlayerName(index, name) {
      state.players[index].name = name;
      // Não chamamos render() aqui para não perder o foco no input
    }

    function updateMaxTime(val) {
      const secs = parseInt(val);
      if (!isNaN(secs) && secs > 0) {
        state.maxTimeMs = secs * 1000;
      }
    }

    function pickRandomQuestion() {
      const available = state.questions.filter(q => !state.usedQuestionIds.includes(q.id));
      if (available.length === 0) return null;
      const randomIndex = Math.floor(Math.random() * available.length);
      const selected = available[randomIndex];
      return { ...selected, options: shuffleArray(selected.options) };
    }

    function startGame() {
      // Validar nomes
      state.players = state.players.map((p, i) => ({
        ...p,
        name: p.name.trim() === '' ? `Jogador ${i + 1}` : p.name
      }));
      
      state.usedQuestionIds = [];
      state.currentRound = 1;
      state.currentPlayerIndex = 0;
      
      const firstQ = pickRandomQuestion();
      if (firstQ) {
        state.currentQuestion = firstQ;
        state.usedQuestionIds.push(firstQ.id);
        state.timeLeft = state.maxTimeMs;
        state.earnedPoints = null;
        state.isAnswering = false;
        changeView('intermission');
      } else {
        alert("Não há perguntas suficientes na base de dados!");
      }
    }

    function handleAnswer(index, isCorrect) {
      if (state.isAnswering) return;
      state.isAnswering = true;
      state.selectedOption = index;
      clearInterval(state.timerInterval);

      if (isCorrect) {
        const timeBonus = Math.round((state.timeLeft / state.maxTimeMs) * 800);
        state.earnedPoints = 200 + timeBonus;
        state.players[state.currentPlayerIndex].score += state.earnedPoints;
      } else {
        state.earnedPoints = 0;
      }

      render(); // Mostrar feedback de cores e pontos

      setTimeout(() => {
        handleNextTurn();
      }, 2000);
    }

    function handleTimeOut() {
      state.isAnswering = true;
      state.selectedOption = -1; // Indica que não escolheu nada
      state.earnedPoints = 0;
      render();

      setTimeout(() => {
        handleNextTurn();
      }, 2000);
    }

    function handleNextTurn() {
      state.isAnswering = false;
      state.selectedOption = null;
      state.earnedPoints = null;

      let nextPlayerIndex = state.currentPlayerIndex + 1;
      let nextRound = state.currentRound;

      if (nextPlayerIndex >= state.players.length) {
        nextPlayerIndex = 0;
        nextRound++;
      }

      if (nextRound > TOTAL_ROUNDS) {
        changeView('podium');
        return;
      }

      const nextQ = pickRandomQuestion();
      if (!nextQ) {
        changeView('podium');
        return;
      }

      state.currentRound = nextRound;
      state.currentPlayerIndex = nextPlayerIndex;
      state.currentQuestion = nextQ;
      state.usedQuestionIds.push(nextQ.id);
      changeView('intermission');
    }

    function resetGame() {
      state.players = [];
      state.playerCount = 1;
      changeView('menu');
    }

    // --- GESTÃO DE PERGUNTAS ---
    function handleAddQuestion(e) {
      e.preventDefault();
      const text = document.getElementById('new-q-text').value;
      const correct = document.getElementById('new-q-correct').value;
      const inc1 = document.getElementById('new-q-inc1').value;
      const inc2 = document.getElementById('new-q-inc2').value;

      if (!text || !correct || !inc1 || !inc2) return;

      const newQ = {
        id: Date.now(),
        text: text,
        options: [
          { text: correct, isCorrect: true },
          { text: inc1, isCorrect: false },
          { text: inc2, isCorrect: false }
        ]
      };

      state.questions.unshift(newQ);
      saveQuestions();
      render(); // Refresh list
    }

    function handleDeleteQuestion(id) {
      state.questions = state.questions.filter(q => q.id !== id);
      saveQuestions();
      render();
    }

    // --- MANIPULAÇÃO DOM (RENDERS) ---
    function updateTimerUI() {
      const timePercentage = (state.timeLeft / state.maxTimeMs) * 100;
      const bar = document.getElementById('timer-bar');
      const text = document.getElementById('timer-text');
      
      if (bar && text) {
        bar.style.width = `${timePercentage}%`;
        let colorClass = 'bg-green-500';
        if (timePercentage < 50) colorClass = 'bg-yellow-500';
        if (timePercentage < 20) colorClass = 'bg-red-500';
        bar.className = `${colorClass} h-3 transition-all duration-100 ease-linear`;

        const secs = Math.ceil(state.timeLeft / 1000);
        text.innerText = `${secs}s`;
        if (state.timeLeft <= 3000) {
          text.className = 'text-2xl font-black text-red-500 animate-pulse';
        } else {
          text.className = 'text-2xl font-black text-slate-800';
        }
      }
    }

    function renderLogo() {
      return `
        <div class="flex justify-center mb-6">
          <img src="${logoUrl}" alt="Logo MA" class="h-24 object-contain rounded-lg shadow-sm bg-white p-2">
        </div>
      `;
    }

    function renderMenu() {
      return `
        <div class="min-h-screen flex items-center justify-center p-4">
          <div class="bg-white max-w-xl w-full rounded-2xl shadow-xl p-8 text-center border-t-8 border-blue-600">
            ${renderLogo()}
            <h1 class="text-4xl font-bold text-slate-800 mb-2">Quiz Competitivo: CEM</h1>
            <p class="text-slate-600 mb-8">Treine a sua equipa com o quiz da Cultura Empresarial Moura.</p>
            
            <div class="space-y-4">
              <button onclick="changeView('setup')" class="w-full flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl transition-all transform hover:scale-105 shadow-lg text-lg">
                <i class="fa-solid fa-circle-play text-2xl"></i> Novo Jogo
              </button>
              <button onclick="changeView('manage')" class="w-full flex items-center justify-center gap-3 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-4 px-8 rounded-xl transition-all text-lg">
                <i class="fa-solid fa-list text-xl"></i> Gerir Perguntas (${state.questions.length})
              </button>
            </div>
          </div>
        </div>
      `;
    }

    function renderSetup() {
      let playersHtml = '';
      for(let i=0; i<state.playerCount; i++) {
        playersHtml += `
          <div>
            <label class="block text-sm font-semibold text-slate-600 mb-1">Nome do Jogador ${i + 1}</label>
            <input type="text" placeholder="Jogador ${i + 1}" value="${state.players[i]?.name || ''}" 
                   oninput="updatePlayerName(${i}, this.value)"
                   class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
          </div>
        `;
      }

      return `
        <div class="min-h-screen flex items-center justify-center p-4">
          <div class="bg-white max-w-xl w-full rounded-2xl shadow-xl p-8 border-t-8 border-blue-600">
            ${renderLogo()}
            <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-3 justify-center">
              <i class="fa-solid fa-users text-blue-600"></i> Configuração da Partida
            </h2>
            
            <div class="mb-6">
              <label class="block text-sm font-bold text-slate-700 mb-2">Quantos jogadores? (Máx 3)</label>
              <div class="flex gap-4">
              ${[1, 2, 3].map(num => `
                <button onclick="updatePlayerCount(${num})" 
                        class="flex-1 py-3 rounded-lg font-bold border-2 transition-colors ${state.playerCount === num ? 'bg-blue-100 border-blue-500 text-blue-700' : 'bg-white border-slate-200 text-slate-500 hover:border-blue-300'}">
                  ${num} ${num === 1 ? 'Jogador' : 'Jogadores'}
                </button>
              `).join('')}
            </div>
          </div>

          <div class="mb-6">
            <label class="block text-sm font-bold text-slate-700 mb-2"><i class="fa-solid fa-stopwatch"></i> Tempo por Pergunta (em Segundos)</label>
            <input type="number" min="5" value="${Math.floor(state.maxTimeMs / 1000)}" oninput="updateMaxTime(this.value)" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none font-bold text-slate-700 bg-white" placeholder="Digite os segundos (ex: 15)" />
          </div>

          <div class="space-y-4 mb-8">
            ${playersHtml}
          </div>

          <div class="flex gap-4">
              <button onclick="changeView('menu')" class="flex-1 py-4 font-bold text-slate-500 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">Voltar</button>
              <button onclick="startGame()" class="flex-1 py-4 font-bold text-white bg-green-500 hover:bg-green-600 rounded-xl transition-colors shadow-lg">Começar Partida</button>
            </div>
          </div>
        </div>
      `;
    }

    function renderIntermission() {
      const currentPlayer = state.players[state.currentPlayerIndex];
      return `
        <div class="min-h-screen flex items-center justify-center p-4 text-center">
          <div class="bg-white max-w-lg w-full rounded-2xl shadow-xl p-10 border-t-8 border-yellow-400">
            ${renderLogo()}
            <div class="mb-2 text-sm font-bold text-slate-400 uppercase tracking-widest">Ronda ${state.currentRound} de ${TOTAL_ROUNDS}</div>
            <h2 class="text-3xl font-bold text-slate-800 mb-4">Passe o dispositivo</h2>
            <p class="text-xl text-slate-600 mb-8">Agora é o turno de:<br/>
              <span class="text-4xl font-black text-blue-600 block mt-2">${currentPlayer.name}</span>
            </p>
            <button onclick="changeView('play')" class="w-full flex justify-center items-center gap-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-full transition-transform transform hover:scale-105 shadow-xl text-lg">
              Estou Pronto <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </div>
      `;
    }

    function renderPlay() {
      const currentPlayer = state.players[state.currentPlayerIndex];
      const progress = ((state.currentRound - 1) / TOTAL_ROUNDS) * 100;
      
      let optionsHtml = state.currentQuestion.options.map((option, index) => {
        let buttonStyle = "bg-white border-slate-300 text-slate-700 hover:border-blue-500 hover:bg-blue-50";
        let iconHtml = '';

        if (state.isAnswering) {
          if (option.isCorrect) {
            buttonStyle = "bg-green-100 border-green-500 text-green-800 font-medium";
            iconHtml = '<i class="fa-solid fa-circle-check text-green-600 text-2xl"></i>';
          } else if (index === state.selectedOption) {
            buttonStyle = "bg-red-100 border-red-500 text-red-800 font-medium";
            iconHtml = '<i class="fa-solid fa-circle-xmark text-red-600 text-2xl"></i>';
          } else {
            buttonStyle = "bg-slate-50 border-slate-200 text-slate-400 opacity-50";
          }
        }

        return `
          <button onclick="handleAnswer(${index}, ${option.isCorrect})" ${state.isAnswering ? 'disabled' : ''} 
                  class="w-full text-left p-4 rounded-xl border-2 transition-all flex justify-between items-center ${buttonStyle}">
            <span class="text-lg">${option.text}</span>
            ${iconHtml}
          </button>
        `;
      }).join('');

      let timeoutMessage = '';
      if (state.isAnswering && state.selectedOption === -1) {
        timeoutMessage = `
          <div class="mb-4 p-3 bg-red-100 text-red-700 border border-red-300 rounded-lg text-center font-bold animate-pulse">
            O tempo esgotou!
          </div>
        `;
      }

      let pointsFeedback = '';
      if (state.isAnswering && state.earnedPoints !== null) {
        pointsFeedback = `
          <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
            <div class="text-5xl font-black px-6 py-4 rounded-2xl shadow-2xl bg-white border-4 ${state.earnedPoints > 0 ? 'text-green-500 border-green-500' : 'text-red-500 border-red-500'} transform transition-transform animate-bounce-custom">
              ${state.earnedPoints > 0 ? '+' + state.earnedPoints : '0'} pts
            </div>
          </div>
        `;
      }

      // Cálculo inicial da barra de progresso (antes do javascript assumir no setInterval)
      const timePercentage = (state.timeLeft / state.maxTimeMs) * 100;
      let timerColor = 'bg-green-500';
      if (timePercentage < 50) timerColor = 'bg-yellow-500';
      if (timePercentage < 20) timerColor = 'bg-red-500';

      return `
        <div class="min-h-screen flex items-center justify-center p-4">
          <div class="bg-white max-w-3xl w-full rounded-2xl shadow-xl overflow-hidden border-t-8 border-blue-600 flex flex-col relative">
            
            <!-- Barra Progresso Rondas -->
            <div class="bg-slate-200 h-2 w-full">
              <div class="bg-blue-600 h-2 transition-all duration-500" style="width: ${progress}%"></div>
            </div>

            <!-- Barra de Tempo Visual -->
            <div class="bg-slate-100 h-3 w-full border-b border-slate-200">
              <div id="timer-bar" class="${timerColor} h-3 transition-all duration-100 ease-linear" style="width: ${timePercentage}%"></div>
            </div>

            <div class="p-8">
              ${renderLogo()}
              <div class="flex justify-between items-center mb-6 border-b pb-4">
                <div>
                  <span class="text-sm font-bold text-slate-500 uppercase block">A jogar agora:</span>
                  <span class="text-xl font-black text-blue-600">${currentPlayer.name}</span>
                </div>
                
                <div class="flex items-center gap-6">
                  <div class="flex flex-col items-center min-w-[60px]">
                    <span class="text-sm font-bold text-slate-500 uppercase flex items-center gap-1">
                      <i class="fa-solid fa-stopwatch"></i> Tempo
                    </span>
                    <span id="timer-text" class="text-2xl font-black ${state.timeLeft <= 3000 ? 'text-red-500 animate-pulse' : 'text-slate-800'}">
                      ${Math.ceil(state.timeLeft / 1000)}s
                    </span>
                  </div>
                  <div class="text-right">
                    <span class="text-sm font-bold text-slate-500 uppercase block">Pontuação</span>
                    <span class="text-2xl font-black text-slate-800">${currentPlayer.score}</span>
                  </div>
                </div>
              </div>

              ${timeoutMessage}

              <h2 class="text-2xl font-bold text-slate-800 mb-8 leading-tight">${state.currentQuestion.text}</h2>

              <div class="space-y-3 relative min-h-[220px]">
                ${pointsFeedback}
                ${optionsHtml}
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function renderPodium() {
      const sortedPlayers = [...state.players].sort((a, b) => b.score - a.score);
      
      let podiumHtml = sortedPlayers.map((player, index) => {
        let medalColor = "text-slate-400";
        let bgColor = "bg-slate-50";
        let borderColor = "border-slate-200";
        if (index === 0) { medalColor = "text-yellow-500"; bgColor = "bg-yellow-50"; borderColor = "border-yellow-400"; }
        else if (index === 1) { medalColor = "text-slate-400"; bgColor = "bg-slate-100"; borderColor = "border-slate-300"; }
        else if (index === 2) { medalColor = "text-amber-600"; bgColor = "bg-orange-50"; borderColor = "border-orange-300"; }

        return `
          <div class="flex items-center justify-between p-4 rounded-xl border-2 ${bgColor} ${borderColor}">
            <div class="flex items-center gap-4">
              <span class="font-black text-2xl ${medalColor}">${index + 1}º</span>
              <span class="text-xl font-bold text-slate-800">${player.name}</span>
            </div>
            <div class="text-right">
              <span class="text-2xl font-black text-slate-800">${player.score}</span>
              <span class="text-sm font-semibold text-slate-500 ml-1">pts</span>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="min-h-screen flex items-center justify-center p-4 text-center">
          <div class="bg-white max-w-3xl w-full rounded-2xl shadow-xl p-8 border-t-8 border-yellow-500">
            ${renderLogo()}
            <i class="fa-solid fa-trophy text-7xl text-yellow-500 mx-auto mb-4 block"></i>
            <h1 class="text-4xl font-black text-slate-800 mb-8">Pódio Final</h1>
            
            <div class="flex flex-col gap-4 mb-10 max-w-md mx-auto">
              ${podiumHtml}
            </div>

            <button onclick="resetGame()" class="inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl transition-all shadow-lg text-lg">
              <i class="fa-solid fa-arrow-rotate-left"></i> Novo Jogo
            </button>
          </div>
        </div>
      `;
    }

    function renderManage() {
      let questionsHtml = state.questions.map(q => {
        let optionsList = q.options.map(opt => `
          <li class="text-xs p-1.5 rounded flex items-center gap-2 ${opt.isCorrect ? 'bg-green-50 text-green-700 font-semibold' : 'bg-slate-50 text-slate-500'}">
            <i class="fa-solid ${opt.isCorrect ? 'fa-circle-check' : 'fa-circle-xmark'}"></i> ${opt.text}
          </li>
        `).join('');

        return `
          <div class="p-4 border border-slate-200 rounded-xl relative hover:border-slate-300 bg-white">
            <button onclick="handleDeleteQuestion(${q.id})" class="absolute top-4 right-4 text-slate-400 hover:text-red-500 transition-colors" title="Apagar">
              <i class="fa-solid fa-trash text-lg"></i>
            </button>
            <p class="font-bold text-slate-800 text-sm mb-2 pr-8">${q.text}</p>
            <ul class="space-y-1">
              ${optionsList}
            </ul>
          </div>
        `;
      }).join('');

      return `
        <div class="min-h-screen p-4 sm:p-8">
          <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden border-t-8 border-slate-800">
            <div class="p-6 bg-slate-50 border-b flex justify-between items-center">
              <div class="flex items-center gap-4">
                <img src="${logoUrl}" alt="Logo MA" class="h-12 object-contain bg-white rounded p-1 shadow-sm">
                <h2 class="text-2xl font-bold text-slate-800 flex items-center gap-3">
                  <i class="fa-solid fa-gear text-slate-600"></i> Gestão de Perguntas
                </h2>
              </div>
              <button onclick="changeView('menu')" class="text-blue-600 font-bold hover:underline">Voltar ao Menu</button>
            </div>

            <div class="p-6 grid md:grid-cols-3 gap-8">
              <!-- Formulário de Adição -->
              <div class="md:col-span-1 bg-slate-50 p-4 rounded-xl border h-fit">
                <h3 class="text-lg font-bold text-slate-700 mb-4 flex items-center gap-2">
                  <i class="fa-solid fa-plus"></i> Adicionar Pergunta
                </h3>
                <form onsubmit="handleAddQuestion(event)" class="space-y-4">
                  <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Pergunta</label>
                    <textarea id="new-q-text" required class="w-full p-2 border rounded-md text-sm outline-none focus:ring-2 focus:ring-blue-500" rows="3"></textarea>
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-green-600 mb-1">Opção Correta</label>
                    <input type="text" id="new-q-correct" required class="w-full p-2 border border-green-300 rounded-md text-sm outline-none focus:ring-2 focus:ring-green-500" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-red-500 mb-1">Opção Incorreta 1</label>
                    <input type="text" id="new-q-inc1" required class="w-full p-2 border border-red-200 rounded-md text-sm outline-none focus:ring-2 focus:ring-red-300" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-red-500 mb-1">Opção Incorreta 2</label>
                    <input type="text" id="new-q-inc2" required class="w-full p-2 border border-red-200 rounded-md text-sm outline-none focus:ring-2 focus:ring-red-300" />
                  </div>
                  <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 rounded-lg text-sm mt-2 transition-colors">Guardar Pergunta</button>
                </form>
              </div>

              <!-- Lista de Perguntas -->
              <div class="md:col-span-2">
                <h3 class="text-lg font-bold text-slate-700 mb-4">Base de Dados (${state.questions.length})</h3>
                <div class="h-[500px] overflow-y-auto pr-2 space-y-3 custom-scrollbar">
                  ${questionsHtml}
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    // --- FUNÇÃO PRINCIPAL DE RENDERIZAÇÃO ---
    function render() {
      const app = document.getElementById('app');
      
      switch (state.view) {
        case 'menu':
          app.innerHTML = renderMenu();
          break;
        case 'setup':
          app.innerHTML = renderSetup();
          break;
        case 'intermission':
          app.innerHTML = renderIntermission();
          break;
        case 'play':
          app.innerHTML = renderPlay();
          break;
        case 'podium':
          app.innerHTML = renderPodium();
          break;
        case 'manage':
          app.innerHTML = renderManage();
          break;
      }
    }

    // --- INICIALIZAÇÃO ---
    window.onload = () => {
      loadQuestions();
      updatePlayerCount(1); // Prepara estado base
      render();
    };

  </script>
</body>
</html>
