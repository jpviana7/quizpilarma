rules_version = '2';

// Regras do banco da Escala de Obreiros ADVEC.
// Cole este arquivo no console do Firebase: Firestore Database > Regras > Publicar.
//
// Qualquer pessoa com o link do app lê as respostas e salva a própria.
// Ninguém consegue apagar respostas pelo app, e os dados precisam ter o formato do app
// (mês, nome, lista de cultos, observação curta).
// Os cultos e eventos de cada mês (coleção "eventos") só muda quem sabe a senha do
// administrador. A senha não fica escrita aqui: a regra compara o código SHA-256 dela.
// Para trocar a senha, troque o código em senhaAdmin() pelo SHA-256 da nova senha
// (em minúsculas) e publique de novo. Fora dessas coleções, nada é liberado.
service cloud.firestore {
  match /databases/{database}/documents {

    function texto(v, max) {
      return v is string && v.size() <= max;
    }

    // SHA-256 da senha do administrador (o valor real não fica no GitHub)
    function senhaAdmin(s) {
      return s is string && s.size() <= 100
        && hashing.sha256(s).toHexString().lower() == 'COLE_AQUI_O_SHA256_DA_SENHA';
    }

    match /respostas/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasAll(['mes', 'nome', 'cultos'])
        && request.resource.data.keys().hasOnly(['mes', 'nome', 'cultos', 'obs', 'atualizado', 'resumo'])
        && request.resource.data.mes is string
        && request.resource.data.mes.matches('^[0-9]{4}-[0-9]{2}$')
        && id.matches('^' + request.resource.data.mes + '_[a-z0-9-]{1,60}$')
        && texto(request.resource.data.nome, 40) && request.resource.data.nome.size() > 0
        && request.resource.data.cultos is list && request.resource.data.cultos.size() <= 80
        && (!('obs' in request.resource.data) || texto(request.resource.data.obs, 300))
        && (!('atualizado' in request.resource.data) || texto(request.resource.data.atualizado, 40))
        && (!('resumo' in request.resource.data) || texto(request.resource.data.resumo, 1500));
      allow delete: if false;
    }

    match /obreiros/{id} {
      allow read: if true;
      allow create: if
        id.matches('^[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['nome'])
        && texto(request.resource.data.nome, 40) && request.resource.data.nome.size() > 0;
      allow update, delete: if false;
    }

    // Cada mudança do administrador cria uma autorização nova com a senha, no mesmo envio.
    // Ninguém consegue ler as autorizações.
    match /autorizacoes/{id} {
      allow create: if id.matches('^[a-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['senha', 'quando'])
        && senhaAdmin(request.resource.data.senha);
      allow read, update, delete: if false;
    }

    match /eventos/{mes} {
      allow read: if true;
      allow create, update: if mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['removidos', 'extras', 'atualizado', 'token'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[a-z0-9]{8,40}$')
        && !exists(/databases/$(database)/documents/autorizacoes/$(request.resource.data.token))
        && existsAfter(/databases/$(database)/documents/autorizacoes/$(request.resource.data.token))
        && request.resource.data.removidos is list && request.resource.data.removidos.size() <= 100
        && request.resource.data.extras is list && request.resource.data.extras.size() <= 40;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
